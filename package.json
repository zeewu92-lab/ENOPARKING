{
  "name": "enoparking-app",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:server\" \"npm:client\"",
    "server": "node server/index.js",
    "client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "db:migrate": "node server/migrate.js",
    "test": "node --test",
    "check:server": "find server api -name '*.js' -print0 | xargs -0 -n1 node --check",
    "test:event-sync": "node --test tests/event-sync.test.js tests/migration-contract.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@neondatabase/serverless": "^1.0.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "vite": "^5.4.0"
  }
}
