# ENOPARKING production environment variables
# Required: Neon PostgreSQL pooled connection string
DATABASE_URL=

# Optional: automatically grant admin role to this username at registration
ENGNOCRAZY_ADMIN_USERNAME=

# Optional one-time admin bootstrap key. Keep private; never commit the real value.
ENGNOCRAZY_ADMIN_SETUP_KEY=

# Recommended: dedicated random secret for password recovery code hashing
ENGNOCRAZY_RECOVERY_SECRET=

# Required for email password recovery
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=語未央

# Required only if SMS password recovery is enabled in the app
BREVO_SMS_SENDER=

# Optional: enterprise WeChat bot for user feedback
WECHAT_WORK_BOT_WEBHOOK=
